{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" is here only so test files typecheck (they import node:test
    // and node:assert). Product code is browser-targeted and must not use
    // Node APIs; esbuild bundles for the browser and would fail on them.
    "types": ["chrome", "node"],
    "paths": {
      "@nco-studio/shared": ["../shared/src/index.ts"],
      "@nco-studio/shared/diff": ["../shared/src/diff.ts"],
      "@nco-studio/shared/layout": ["../shared/src/layout.ts"],
      "@nco-studio/shared/protocol": ["../shared/src/protocol.ts"]
    }
  },
  "include": ["src"],
  // Test files are deliberately INCLUDED. They used to be excluded, and that
  // let a test import a symbol which had been moved to another module: tsc
  // --noEmit passed, and only the test runner's esbuild caught it. A test that
  // does not compile is not a test.
  "exclude": []
}
