{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "paths": {
      "@nco-studio/shared": ["../shared/src/index.ts"],
      "@nco-studio/shared/diff": ["../shared/src/diff.ts"],
      "@nco-studio/shared/protocol": ["../shared/src/protocol.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
