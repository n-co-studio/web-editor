{
  "name": "@nco-studio/chrome-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "build:web-embed:copy": "node ./scripts/copy-web-embed.mjs",
    "build:web-embed": "node esbuild.config.js && npm run build:web-embed:copy",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/run-tests.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nco-studio/shared": "0.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.0"
  }
}
