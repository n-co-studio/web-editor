{
  "manifest_version": 3,
  "name": "n'co studio Web Editor",
  "description": "Select elements on your localhost dev page, adjust them visually, and send structured diffs to Claude Code via a local MCP server.",
  "version": "0.2.0",
  "author": "n'co studio",
  "homepage_url": "https://github.com/n-co-studio/web-editor",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_icon": {
      "16": "icons/status/nco-web-editor-icon-disabled.png",
      "48": "icons/status/nco-web-editor-icon-disabled.png",
      "128": "icons/status/nco-web-editor-icon-disabled.png"
    },
    "default_title": "n'co studio Web Editor",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
