{
  "name": "@nco-studio/web-editor-plugin",
  "version": "0.2.0",
  "description": "Vite and Babel plugin for Visual Web Editor for AI Agents — injects source location metadata for in-browser editing",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js",
      "require": "./dist/babel.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "magic-string": "^0.30.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.26.0",
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "n'co studio (Mark Preston) <hello@markpreston.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-co-studio/web-editor.git",
    "directory": "packages/dev-plugin"
  },
  "homepage": "https://github.com/n-co-studio/web-editor/tree/main/packages/dev-plugin#readme",
  "bugs": {
    "url": "https://github.com/n-co-studio/web-editor/issues"
  },
  "keywords": [
    "vite-plugin",
    "babel-plugin",
    "visual-editing",
    "source-maps",
    "nco-studio"
  ],
  "publishConfig": {
    "access": "public"
  }
}
