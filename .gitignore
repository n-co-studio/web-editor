# BEGIN REPO-OS MANAGED — template-sync, see AI.md
# DO NOT EDIT between these markers — managed by template-sync
# DO NOT EDIT between these markers — managed by template-sync

# OS
.DS_Store

# Office
*.pptx
~$*

# Node.js / TypeScript build artifacts
node_modules/
dist/
*.tsbuildinfo

# Claude Code personal settings
.claude/settings.local.json

# Repo mode (absent = child default; template repos create this locally)
.claude/repo-mode

# HVST failure counter (session-scoped temp file)
.claude/.hvst-fail-count

# Session-scoped state files (stop hook baselines)
.claude/.session-baseline-sha
.claude/.session-id
.claude/.session-id.*
.claude/.session-type

# Governance state files (session-scoped, written by SubagentStop hook)
**/.claude/.state/*
!**/.claude/.state/.gitkeep
.claude/phase-state
editor-queue-status.yaml

# Local-only template development files (not shipped to products)
.claude/local/

# Analytics data — legacy per-repo location (active data now at ~/.local/share/repo-os-analytics/)
.claude/analytics/

# Automation runtime artifacts (Decision 0017)
.claude/.automation/.queue-lock/
.claude/.automation/queue/
.claude/.automation/reports/
.claude/.automation/review-items/
.claude/.automation/escalations/
.claude/.automation/briefs/
.claude/.automation/logs/

# Transient daemon control flags. These are runtime signals, not configuration:
# HALT stops the daemon between entries, FORCE-HALT kills the running session.
# They were not ignored, and on 2026-10-21 a `git add -A` committed HALT — which
# would have shipped a "do not start" flag to every child repo on the next
# template sync and left their daemons refusing to run for no visible reason.
.claude/.automation/HALT
.claude/.automation/FORCE-HALT

# Eval study raw artifacts — gitignored to prevent accidental secret commits (Decision t-0046)
# Committed study records live in docs/ai/eval/ (tracked).
# Raw cell artifacts (diffs, transcripts, judge outputs, blinded submissions) stay here only.
.claude/.automation/reports/eval/

# Operator-specific child repo registry (use child-repos.conf.example as template)
.claude/.automation/child-repos.conf

# Knowledge graph lock directories (Decision 0034)
docs/ai/knowledge-graph/.graph-lock
docs/ai/knowledge-graph/.product-graph-lock

# Session worktree isolation (Decision 0033)
.worktrees/
# END REPO-OS MANAGED

# Chrome Web Store package output (project-local, not template-managed)
# package-extension.mjs builds the submission zip here. It was in the managed
# block until the 2026-09-25 template sync dropped it, which left the built
# zip showing as untracked and one `git add -A` away from being committed.
# Kept below the markers so template sync cannot take it again.
packages/chrome-extension/dist-zip/
dist-zip/

# npm pack output. scripts/smoke-test.mjs is a documented pre-release step and
# packs both public packages into the package dirs; without this a `git add -A`
# after running it commits the tarballs.
*.tgz

# MCP server runtime state (project-local, not template-managed)
# server.lock holds the running server's PID; pending-queue.json is the
# crash-recovery queue described in docs/spec/compiled/v1/architecture.md.
# Both are local runtime state — never source.
.nco-web-editor/
